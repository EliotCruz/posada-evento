---
// Recortes de la imagen horizontal para pantallas angostas: guirnalda (arriba-izquierda) o árbol (abajo-derecha),
// con los bordes difuminados para que se fundan con el fondo crema.
interface Props { pos: 'arriba' | 'abajo'; class?: string }
const { pos, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const arriba = pos === 'arriba';
// Región de la imagen (2000×1116): guirnalda x 0–1000, y 0–730 · árbol x 1080–2000, y 230–1116.
const R = arriba ? { x: 0, y: 0, w: 1000, h: 600 } : { x: 1080, y: 230, w: 920, h: 886 };
const f = (g: string) => `linear-gradient(${g},#000 70%,transparent)`;
const mascara = arriba ? `${f('to bottom')},${f('to left')}` : `${f('to top')},${f('to right')}`;
const estilo = `aspect-ratio:${R.w}/${R.h};mask-image:${mascara};-webkit-mask-image:${mascara};mask-composite:intersect;-webkit-mask-composite:source-in`;
const imgEstilo = `width:${(2000 / R.w) * 100}%;margin-left:-${(R.x / R.w) * 100}%;margin-top:-${(R.y / R.w) * 100}%`;
---
<div class={`pointer-events-none overflow-hidden ${arriba ? 'w-[min(100%,520px)]' : 'ml-auto w-[min(78%,340px)]'} ${cls}`} style={estilo} aria-hidden="true">
  <img src={`${base}/fondos/fondo-horizontal.jpg`} alt="" width="2000" height="1116" class="block max-w-none" style={imgEstilo} />
</div>
