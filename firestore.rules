rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contador del número de sorteo consecutivo. El público solo puede sumarle exactamente 1 (al registrarse).
    match /meta/contador {
      allow read: if true;
      allow update: if request.resource.data.keys().hasOnly(['ultimo'])
                    && request.resource.data.ultimo == resource.data.ultimo + 1;
      allow write: if esAdmin();
    }

    // Padrón de colaboradores invitados (número -> nombre). Se puede consultar por número (get), nunca listar.
    match /padron/{emp} {
      allow get: if true;
      allow list, write: if esAdmin();
    }

    // Registros: el público solo CREA (una vez por empleado) y no puede leer ni listar.
    match /registros/{emp} {
      allow create: if emp.matches('^[A-Z0-9-]{1,20}$')
        && request.resource.data.keys().hasOnly(['nombre','telefono','empleado','transporte','numero','codigo','creado'])
        && request.resource.data.empleado == emp
        && exists(/databases/$(database)/documents/padron/$(emp))
        && request.resource.data.nombre == get(/databases/$(database)/documents/padron/$(emp)).data.nombre
        && request.resource.data.telefono.matches('^[0-9]{10}$')
        && request.resource.data.transporte is bool
        && request.resource.data.numero is int
        && request.resource.data.codigo.matches('^[A-Z2-9]{3}-[A-Z2-9]{3}$')
        && request.resource.data.creado == request.time
        && request.resource.data.numero == getAfter(/databases/$(database)/documents/meta/contador).data.ultimo
        && getAfter(/databases/$(database)/documents/meta/contador).data.ultimo
           == get(/databases/$(database)/documents/meta/contador).data.ultimo + 1;
      allow read, update, delete: if esAdmin();
    }

    match /ganadores/{n} {
      allow read, write: if esAdmin();
    }

    // Cada usuario solo puede comprobar si él mismo es admin. Los admins se crean desde la consola.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
